# Copia este archivo a .env.local y rellena los valores.
# Solo se usa en desarrollo, para el botón «Publicar» del panel /admin.
#
# GH_TOKEN: Personal Access Token de GitHub con permiso de escritura de
#           contenidos en el repositorio (fine-grained: Contents = Read and write).
# GH_REPO:  owner/repo de destino, por ejemplo bryan1605/crux
# SITE_URL: (opcional) URL pública para sitemap.xml y robots.txt
GH_TOKEN=
GH_REPO=bryan1605/crux
SITE_URL=https://bryan1605.github.io/crux
